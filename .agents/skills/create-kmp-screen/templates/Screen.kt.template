/**
 * {{中文名}} 页面入口。
 *
 * 入口只负责 ViewModel、State、Effect 和 Action 路由；标题与无障碍文案由宿主从 Compose Resources 传入。
 */
@Composable
fun {{NAME}}Screen(
    title: String,
    backContentDescription: String,
    viewModel: {{NAME}}ViewModel = viewModel(::{{NAME}}ViewModel),
    onBack: () -> Unit,
) {
    val state by viewModel.state.collectAsStateWithLifecycle()

    viewModel.collectSideEffects { effect ->
        when (effect) {
            {{NAME}}Effect.NavigateBack -> onBack()
        }
    }

    {{NAME}}Content(
        state = state,
        title = title,
        backContentDescription = backContentDescription,
        onAction = viewModel.dispatchAction,
    )
}

/**
 * {{中文名}}页面的纯 UI。
 *
 * 只依赖 UI state、资源化文案和 Action 回调，因此可以在同一文件中独立预览。
 */
@Composable
private fun {{NAME}}Content(
    state: {{NAME}}UiState,
    title: String,
    backContentDescription: String,
    onAction: ({{NAME}}Action) -> Unit,
) = ScreenScaffold(
    title = title,
    topBar = {
        IconButton(onClick = { onAction({{NAME}}Action.BackClick) }) {
            // 生成后按项目 IconPack 替换为该页面的返回图标；模板不依赖 Material Icons。
            Icon(
                imageVector = IconPack.ArrowRight,
                contentDescription = backContentDescription,
            )
        }
    },
) {
    Column(
        modifier = Modifier.fillMaxWidth(),
        verticalArrangement = Arrangement.spacedBy(AppTheme.spacings.medium),
    ) {
        // TODO({{name}}): 使用 Compose Resources 文案和主题令牌实现页面内容。
        state.templateMessage?.let { message ->
            Text(
                text = message,
                color = AppTheme.colorScheme.error,
                style = AppTheme.typography.bodyMedium,
            )
        }
    }
}

/** {{中文名}}页面内容预览。 */
@AppPreview
@Composable
private fun {{NAME}}ContentPreview() = AppPreview {
    {{NAME}}Content(
        state = {{NAME}}UiState(templateMessage = null),
        title = "",
        backContentDescription = "",
        onAction = {},
    )
}
